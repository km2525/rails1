<div class="form-card">
  <%= form_with(model: schedule, local: true) do |f| %>

    <!-- タイトル -->
    <div class="form-group">
      <%= f.label :title, "タイトル", class: "form-label required" %>
      <%= f.text_field :title, placeholder: "タイトル", class: "form-input" %>
    </div>

    <!-- 日付（横並び） -->
    <div class="form-row">
    <div class="form-group">
    <%= f.label :start_date, "開始日 *" %>
    <%= f.text_field :start_date, class: "js-date-picker" %>
    </div>

    <div class="form-group">
    <%= f.label :end_date, "終了日 *" %>
    <%= f.text_field :end_date, class: "js-date-picker" %>
    </div>

    </div>

    <!-- 終日チェック -->
    <div class="form-group checkbox-group">
      <%= f.check_box :all_day %>
      <%= f.label :all_day, "終日の場合はチェックを入れます" %>
    </div>

    <!-- メモ -->
    <div class="form-group">
      <%= f.label :memo, "スケジュールメモ", class: "form-label" %>
      <%= f.text_area :memo, rows: 5, placeholder: "メモを入力する", class: "form-textarea" %>
    </div>

    <!-- ボタン -->
    <div class="form-actions">
      <%= link_to "キャンセル", schedules_path, class: "btn btn-secondary" %>
      <%= f.submit "保存", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>
